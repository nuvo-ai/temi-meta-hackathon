# Meta Model API — https://dev.meta.ai/docs/
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Muse Spark always reasons; "none" is rejected. Lower = faster first word on a call.
# minimal matched low on every eval case at about half the time to first word.
META_REASONING_EFFORT=minimal
# Model used by the fraud check. It runs while the caller waits, so keep effort
# minimal: check `npx tsx evals/guard-bench.ts --effort <level>` before raising it.
GUARD_MODEL=muse-spark-1.3
GUARD_REASONING_EFFORT=minimal

# Server
PORT=8787
# Bearer token Temi's call server must send to /v1/*
BRAIN_API_KEY=change-me

# Tools: "mock" runs the in-memory bank in this repo; "http" forwards tool
# calls to Temi's real banking endpoint.
TOOL_EXECUTOR=mock
TOOL_EXECUTOR_URL=
TOOL_EXECUTOR_KEY=

# Fraud check thresholds for Nigeria (naira). Kenya and Ghana: src/countries.ts
GUARD_STEP_UP_NGN=50000
GUARD_NEW_RECIPIENT_STEP_UP_NGN=10000

# Eval cost reporting. Prices in USD per 1M tokens, from Meta's pricing page.
META_PRICE_IN_PER_M=0
META_PRICE_OUT_PER_M=0
USD_TO_NGN=1500

# Live demo calls (src/voice.ts): point a Twilio number's voice webhook at
# POST <PUBLIC_URL>/voice/incoming. Everything below is optional.
PUBLIC_URL=
# Set with PUBLIC_URL to reject requests that aren't signed by Twilio.
TWILIO_AUTH_TOKEN=
# Twilio <Say> voice, e.g. Polly.Ayanda-Neural. Empty uses Twilio's default.
TWILIO_VOICE=
# Force a country for every call: NG, KE, GH, TZ or UG. Empty: from the caller's number.
VOICE_COUNTRY=
