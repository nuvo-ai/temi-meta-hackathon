# Meta Model API (OpenAI-compatible) — https://dev.meta.ai/docs/
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Muse Spark always reasons; "none" is rejected. Lower = faster first word on a call.
META_REASONING_EFFORT=low
# Model used by the fraud check (can be the same model at higher effort).
GUARD_MODEL=muse-spark-1.3
GUARD_REASONING_EFFORT=medium

# Baseline for evals: Temi's previous model.
BASELINE_API_KEY=
BASELINE_BASE_URL=https://api.openai.com/v1
BASELINE_MODEL=gpt-4o-mini

# Which provider the server and CLI use: meta | baseline
PROVIDER=meta

# Server
PORT=8787
# Bearer token Temi's call server must send to /v1/*
BRAIN_API_KEY=change-me

# Tools: "mock" runs the in-memory bank in this repo; "http" forwards tool
# calls to Temi's real banking endpoint.
TOOL_EXECUTOR=mock
TOOL_EXECUTOR_URL=
TOOL_EXECUTOR_KEY=

# Fraud check thresholds (naira)
GUARD_STEP_UP_NGN=50000
GUARD_NEW_RECIPIENT_STEP_UP_NGN=10000

# Eval cost reporting. Prices in USD per 1M tokens; fill from each provider's pricing page.
META_PRICE_IN_PER_M=0
META_PRICE_OUT_PER_M=0
BASELINE_PRICE_IN_PER_M=0.15
BASELINE_PRICE_OUT_PER_M=0.60
USD_TO_NGN=1500
